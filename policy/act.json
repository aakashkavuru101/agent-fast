{
  "default": "deny",
  "allow": [
    "launch", "navigate", "back", "forward", "reload", "snapshot", "scroll", "wait",
    "waitforurl", "waitforloadstate", "read", "get", "gettext", "innerhtml", "url", "title",
    "count", "getattribute", "inputvalue", "isvisible", "isenabled", "ischecked", "tab_new", "tab_list",
    "tab_switch", "close", "frame", "mainframe", "screenshot", "console", "errors", "requests",
    "dialog", "recording_start", "recording_stop", "click", "dblclick", "fill", "type", "keyboard",
    "press", "hover", "focus", "check", "uncheck", "select", "drag", "scrollintoview",
