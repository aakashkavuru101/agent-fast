{
  "name": "@aakashkavuru101/agent-fast",
  "version": "0.4.0",
  "description": "Local-first browser runtime for AI agents: egress-proxy containment, a closed tool catalog, MCP, and replayable workflows",
  "keywords": [
    "browser-automation",
    "ai-agent",
    "mcp",
    "testing",
    "power-platform",
    "security"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aakashkavuru101/agent-fast.git"
  },
  "bugs": {
    "url": "https://github.com/aakashkavuru101/agent-fast/issues"
  },
  "homepage": "https://github.com/aakashkavuru101/agent-fast#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "agent-fast": "dist/cli.js"
  },
  "files": [
    "dist",
    "policy",
    "README.md",
    "README.ja.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "benchmark": "node benchmarks/warm.mjs",
    "benchmark:agent": "node benchmarks/agent-eval.mjs",
    "prepublishOnly": "npm test",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "agent-browser": "0.41.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "playwright": "^1.65.0",
    "typescript": "7.0.2"
  }
}
